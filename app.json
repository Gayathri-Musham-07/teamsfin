{
  "expo": {
    "name": "Teams",
    "slug": "MyApp",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/teams-icon.jpg",

    "scheme": "myapp",
    "userInterfaceStyle": "automatic",

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/Teams-bg.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gayathrimusham.MyApp"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/Teams-bg.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/Teams-bg.png",
          "imageWidth": 110
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "a74e9c26-9d52-43b7-9be2-26b0e758ab87"
      }
    }
  }
}
